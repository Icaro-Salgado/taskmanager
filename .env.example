# Copy to .env (run.sh and run.ps1 do it on first start). Every value here is for local demo use only.

# Django
DJANGO_SECRET_KEY=demo-only-insecure-key-replace-it-before-any-real-deployment-7f3a9c
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000

# Logging level for the application logs (written to stderr)
LOG_LEVEL=INFO

# Time zone used by Django and by the scheduled jobs
TIME_ZONE=America/Sao_Paulo

# PostgreSQL. POSTGRES_PORT is the port published on the host, for tests run outside Docker and for
# database clients; containers always reach the database at db:5432.
POSTGRES_DB=taskmanager
POSTGRES_USER=taskmanager
POSTGRES_PASSWORD=demo-only-password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis, as seen from the host. Containers use redis://redis:6379/0.
REDIS_URL=redis://localhost:6379/0

# Port published on the host for the API
API_PORT=8000
